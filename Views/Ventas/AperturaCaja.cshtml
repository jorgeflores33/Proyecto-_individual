@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<title>
    Apertura de Caja
</title>

<link
    rel="stylesheet"
    href="@Url.Content("~/frontend/interno/venta/css/venta_apertura_caja.css")"
>

</head>

<body>

<header class="navbar">

    <div class="logo">
        💰 Apertura de Caja
    </div>

    <div class="acciones">

        <button
            onclick="window.location.href='/Ventas/Index'"
        >
            ← Volver
        </button>

        <button onclick="logout()">
            Cerrar sesión
        </button>

    </div>

</header>


<div class="contenedor">

    <div class="card">

        <!-- HEADER -->
        <div class="card-header">

            <!-- FILTROS -->
            <div class="filtros">

                <input
                    type="date"
                    id="filtroFecha"
                >

                <button onclick="filtrar()">
                    🔍 Buscar
                </button>

            </div>


            <!-- BOTON -->
            <button
                class="btn-crear"
                onclick="abrirModal()"
            >
                + Registrar Apertura
            </button>

        </div>


        <!-- TABLA -->
        <table>

            <thead>

                <tr>

                    <th>ID</th>

                    <th>Usuario</th>

                    <th>Trabajador</th>

                    <th>Sucursal</th>

                    <th>Monto Inicial</th>

                    <th>Fecha y Hora</th>

                    <th>Acciones</th>

                </tr>

            </thead>


            <tbody id="tablaApertura">

                <tr>

                    <td colspan="7">

                        Cargando...

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>



<!-- 🔥 MODAL -->
<div
    id="modalCaja"
    class="modal"
>

    <div class="modal-box">

        <h2>
            Registrar Apertura
        </h2>


        <!-- USUARIO -->
        <label>
            Usuario
        </label>

        <input
            type="text"
            id="nombreUsuario"
            readonly
        >


        <!-- TRABAJADOR -->
        <label>
            Trabajador
        </label>

        <input
            type="text"
            id="nombreTrabajador"
            readonly
        >


        <!-- SUCURSAL -->
        <label>
            Sucursal
        </label>

        <select id="sucursal">

            <option value="">
                Seleccionar sucursal
            </option>

        </select>


        <!-- MONTO -->
        <label>
            Monto Inicial
        </label>

        <input
            type="number"
            id="monto"
            placeholder="Monto inicial"
            min="0"
        >


        <!-- BOTONES -->
        <div class="botones">

            <button onclick="guardar()">
                💾 Guardar
            </button>

            <button onclick="cerrarModal()">
                ❌ Cancelar
            </button>

        </div>

    </div>

</div>


<script src="@Url.Content("~/frontend/interno/venta/js/venta_apertura_caja.js")"></script>

</body>
</html>