@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<title>
    Entrada de Mercancía
</title>

<link
    rel="stylesheet"
    href="@Url.Content("~/frontend/interno/almacen/css/almacen_entrada.css")"
>

</head>

<body>

<header class="navbar">

    <div class="logo">
        📥 Entrada de Mercancía
    </div>

    <div class="acciones">

        <button onclick="ir('/Almacen/Index')">
            ← Volver
        </button>

        <button onclick="logout()">
            Cerrar sesión
        </button>

    </div>

</header>


<div class="layout">



    <!-- CONTENIDO -->
    <main class="contenido">

        <!-- CARD PRINCIPAL -->
        <div class="card">

            <div class="card-header">

                <h2>
                    Existencia
                </h2>

                <button
                    class="btn-crear"
                    onclick="abrirModal()"
                >
                    + Registrar Entrada
                </button>

            </div>

        </div>


        <!-- REGISTROS -->
        <div class="card-registros">

            <h2>
                Historial de Entradas
            </h2>

            <table>

                <thead>

                    <tr>

                        <th>Producto</th>
                        <th>Sucursal</th>
                        <th>Cantidad</th>

                    </tr>

                </thead>

                <tbody id="tablaRegistros">

                    <tr>

                        <td colspan="3">
                            No hay entradas
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </main>

</div>


<!-- MODAL -->
<div
    id="modalEntrada"
    class="modal"
>

    <div class="modal-box">

        <h2>
            Nueva Entrada
        </h2>


        <!-- PRODUCTO -->
        <select id="producto">

            <option value="">
                Seleccionar producto
            </option>

        </select>


        <!-- SUCURSAL -->
        <select id="sucursal">

            <option value="">
                Seleccionar sucursal
            </option>

        </select>


        <!-- CANTIDAD -->
        <input
            type="number"
            id="cantidad"
            placeholder="Cantidad"
        >


        <div class="botones">

            <button onclick="guardar()">
                💾 Guardar
            </button>

            <button onclick="cerrarModal()">
                ❌ Cancelar
            </button>

        </div>

    </div>

</div>

<script src="@Url.Content("~/frontend/interno/almacen/js/almacen_entrada.js")"></script>

</body>
</html>