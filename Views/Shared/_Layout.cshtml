<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PAPELABORANTE</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="cabecera-mvc">
        <a asp-controller="Home" asp-action="Index">PAPELABORANTE</a>
        <nav><a asp-controller="Home" asp-action="Index">Inicio</a>
             <a asp-controller="Externo" asp-action="Productos">Productos</a></nav>
    </header>
    <main class="contenedor-mvc" role="main">@RenderBody()</main>
    <footer class="pie-mvc">PAPELABORANTE</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
